# ── Database_Mode ──────────────────────────────────────────────────────────
# Use true for local/demo data, or false when MySQL variables below are set.
USE_MOCK_DB = true

# ── MySQL_Credentials ────────────────────────
MYSQL_HOST = localhost
MYSQL_PORT = 3306
MYSQL_USER = root
MYSQL_PASSWORD =
MYSQL_DATABASE = sikkim_tourism

# ── Gemini_AI ───────────────────────────────────────────────────────────
GEMINI_API_KEY =
GEMINI_MODEL = gemini-2.5-flash
GEMINI_EMBEDDING_MODEL = models/gemini-embedding-001

# ── Groq_AI ───────────────────────────────────────────────────────────
GROQ_API_KEY =
GROQ_MODEL = llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL = llama-3.1-8b-instant
ENABLE_PROMPT_GUARD = false
PROMPT_GUARD_MODEL = meta-llama/llama-prompt-guard-2-86m

# ── Tavily_AI ───────────────────────────────────────────────────────────
TAVILY_API_KEY =
ENABLE_FOLLOWUPS = true

# ── Optional automated circular scraper ───────────────────────────────────
# Keep false on a 512 MiB Render web service.  Enabling it requires the
# packages in requirements-circular-scraper.txt and Firefox/geckodriver.
ENABLE_CIRCULAR_SCRAPER = false

# ── Qdrant_Vector_Store ───────────────────────────────────────────────────────
QDRANT_URL =
QDRANT_API_KEY =
QDRANT_COLLECTION = sikkim_destinations

# ── Admin_Authentication_Security ───────────────────────────────────────────────────────
# To Generate Unique Code, Run : `` python -c "import secrets; print(secrets.token_urlsafe(32)) ``
ADMIN_API_KEY =

# ── CORS_Configuration ────────────────────────────────────────────────
ALLOWED_ORIGINS = http://localhost:5173
ALLOWED_METHODS = GET, POST, OPTIONS
ALLOWED_HEADERS = Content-Type,Authorization,X-Admin-Key

# ── Environment_Configuration ───────────────────────────────────────────────────────
ENVIRONMENT = development

# ─────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────
