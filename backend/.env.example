# ── Database_Mode ──────────────────────────────────────────────────────────
USE_MOCK_DB=true

# ── MySQL_Credentials ────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sikkim_tourism

# ── Gemini_AI ───────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# NOTE: text-embedding-004 was retired by Google in late 2025.
# Use models/gemini-embedding-001 (recommended, 3072-dim by default).
# Dimension is auto-detected at runtime, so this can be changed safely.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ── Groq_AI ───────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Tavily_Web_Search_(Hybrid_RAG) ───────────────────────────────────────
TAVILY_API_KEY=

# ── Qdrant vector store ───────────────────────────────────────────────────────
# Leave QDRANT_URL empty for fully in-memory mode (default, no server needed).
# The vector store is auto-populated from mock_db (or MySQL) on every startup.
#
# For persistent storage, uncomment one of the options below:
#
# Option A — Local Qdrant server (run: docker run -p 6333:6333 qdrant/qdrant)
# QDRANT_URL=http://localhost:6333
#
# Option B — Qdrant Cloud (https://cloud.qdrant.io)
# QDRANT_URL=https://YOUR-CLUSTER-ID.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-cloud-api-key
#
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sikkim_destinations

# ── CORS Configuration (SECURITY) ────────────────────────────────────────────────
# ⚠️  In production, MUST set to your exact frontend URL. DO NOT use '*'
ALLOWED_ORIGINS=http://localhost:5173
# Restrict to necessary HTTP methods
ALLOWED_METHODS=GET,POST,OPTIONS
# Restrict to necessary headers
ALLOWED_HEADERS=Content-Type,Authorization

# ── Environment ────────────────────────────────���───────────────────────────
# Set to 'production' in production deployments
ENVIRONMENT=development
